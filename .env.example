# Salin ke .env.local (untuk apps/web) dan/atau .env (untuk apps/wa-engine).
# File ini HANYA berisi placeholder — JANGAN isi kredensial asli di repo.
# Semua nilai rahasia (API key, session) hanya ada di file .env lokal
# masing-masing mesin dan TIDAK PERNAH di-commit (lihat .gitignore).

# Database SQLite lokal. Di Windows pakai path absolut, contoh:
# DATABASE_URL=file:C:/wa-tools/data/wa-tools.db
DATABASE_URL=file:./data/wa-tools.db

# Gateway AI lokal (OpenAI-compatible). Default sesuai SPEC §5/§9.
AI_GATEWAY_BASE_URL=http://localhost:20128/v1
AI_API_KEY=
AI_MODEL_DRAFT=

# URL service wa-engine yang dipakai dashboard.
WA_ENGINE_URL=http://localhost:3101

# Batas kirim (SPEC §7 settings). Nilai default diisi saat implementasi,
# bukan di file contoh ini:
# SEND_DELAY_MIN_MS=
# SEND_DELAY_MAX_MS=
# SEND_DAILY_LIMIT=
# QUIET_HOURS=
